# Copy to .env.local and fill in.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Any long random string: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# For `npm test`: put these in .env.test, pointing at a separate test database.
# Tests create and delete users, so never use your real database here.
# DATABASE_URL, BETTER_AUTH_SECRET, and BETTER_AUTH_URL="http://localhost:3100"

# Optional, for the gift quiz. It uses a hand-picked list without these.
# Free key, no card: https://aistudio.google.com
GEMINI_API_KEY=""

# Optional, for "Continue with Google". Free: https://console.cloud.google.com
# Redirect URI: https://<your-site>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
